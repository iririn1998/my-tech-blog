---
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	type?: 'website' | 'article';
	/** 記事ページで、スクロール後にヘッダーへ表示する記事タイトル */
	contextTitle?: string;
}

const {
	title,
	description = 'Webフロントエンドを中心とした、個人の技術記録。',
	type = 'website',
	contextTitle,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<!-- 描画前にテーマを決めて、ちらつきを防ぐ -->
		<script is:inline>
			(() => {
				let theme;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:site_name" content="いりりんご🍎web牧場" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body id="page-top">
		<a class="skip-link" href="#main-content">本文へ移動</a>
		<SiteNav contextTitle={contextTitle} />
		<main id="main-content" class="container"><slot /></main>
		<SiteFooter />
		<a class="back-to-top" href="#page-top">
			<svg class="ring" viewBox="0 0 56 56" aria-hidden="true" focusable="false">
				<circle class="ring-track" cx="28" cy="28" r="24"></circle>
				<circle class="ring-fill" cx="28" cy="28" r="24"></circle>
			</svg>
			<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M12 19V6M6.5 11.5 12 6l5.5 5.5"></path>
			</svg>
			<span class="visually-hidden">ページ上部へ戻る</span>
		</a>
		<div class="toast-region" role="status" aria-live="polite" data-toast-region></div>
	</body>
</html>

<style>
	.container {
		max-width: var(--layout-max-width);
		margin: 0 auto;
		padding: 0 var(--layout-gutter);
	}

	/* キーボード操作時のみ表示されるスキップリンク */
	.skip-link {
		position: absolute;
		top: 8px;
		left: 8px;
		z-index: 70;
		padding: 8px 16px;
		border-radius: var(--radius-md);
		background: var(--color-bg);
		font-weight: 700;
		transform: translateY(-200%);
	}

	.skip-link:focus-visible {
		transform: none;
	}

	/*
	 * ページトップへ戻るボタン。
	 * Scroll-driven Animations 対応ブラウザでは、少し読み進めると現れ、周囲のリングで読了率を示す。
	 * 未対応ブラウザでは常に表示する。
	 */
	.back-to-top {
		position: fixed;
		right: clamp(16px, 3vw, 32px);
		bottom: clamp(16px, 3vw, 32px);
		z-index: 30;
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--color-bg);
		color: var(--color-ink);
		box-shadow: 0 8px 22px -10px var(--color-shadow);
	}

	.back-to-top:focus-visible {
		border-radius: 50%;
	}

	.ring {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		transform: rotate(-90deg);
	}

	.ring-track,
	.ring-fill {
		fill: none;
		stroke-width: 2.5;
	}

	.ring-track {
		stroke: var(--color-line);
	}

	.ring-fill {
		stroke: var(--color-leaf);
		stroke-linecap: round;
		stroke-dasharray: 151;
		stroke-dashoffset: 151;
	}

	.arrow {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) {
		.back-to-top:hover .arrow {
			transform: translateY(-3px);
		}
	}

	@supports (animation-timeline: scroll()) {
		.back-to-top {
			animation: back-to-top-in linear both;
			animation-timeline: scroll(root);
			animation-range: 0 480px;
		}

		.ring-fill {
			animation: ring-fill linear both;
			animation-timeline: scroll(root);
		}
	}

	@keyframes back-to-top-in {
		from {
			opacity: 0;
			visibility: hidden;
			transform: translateY(12px) scale(0.9);
		}

		to {
			opacity: 1;
			visibility: visible;
			transform: none;
		}
	}

	@keyframes ring-fill {
		from {
			stroke-dashoffset: 151;
		}

		to {
			stroke-dashoffset: 0;
		}
	}
</style>
