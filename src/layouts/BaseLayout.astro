---
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	type?: 'website' | 'article';
}

const {
	title,
	description = 'Webフロントエンドを中心とした、個人の技術記録。',
	type = 'website',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:site_name" content="いりりんご🍎web牧場" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body id="page-top">
		<a class="back-to-top" href="#page-top" aria-label="ページ上部へ戻る" title="ページ上部へ戻る">
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M5 5h14M12 19V9M7.5 13.5 12 9l4.5 4.5" />
			</svg>
		</a>
		<SiteNav />
		<div class="container">
			<main id="main-content"><slot /></main>
			<SiteFooter />
		</div>
	</body>
</html>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 clamp(20px, 5vw, 72px);
	}

	.back-to-top {
		position: fixed;
		right: clamp(16px, 3vw, 32px);
		bottom: clamp(16px, 3vw, 32px);
		z-index: 10;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		background: var(--color-paper);
		border: 1px solid var(--color-text);
		border-radius: 50%;
		color: var(--color-text);
		text-decoration: none;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease,
			transform 160ms ease;
	}

	.back-to-top svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	@media (hover: hover) {
		.back-to-top:hover {
			background: var(--color-accent-700);
			border-color: var(--color-accent-700);
			color: var(--color-paper);
			transform: translateY(-2px);
		}
	}
</style>
