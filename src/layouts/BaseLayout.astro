---
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	type?: 'website' | 'article';
}

const {
	title,
	description = 'Webフロントエンドを中心とした、個人の技術記録。',
	type = 'website',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:site_name" content="Web技報" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Noto+Serif+JP:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">本文へ移動</a>
		<SiteNav />
		<div class="container">
			<main id="main-content"><slot /></main>
			<SiteFooter />
		</div>
	</body>
</html>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 clamp(20px, 5vw, 72px);
	}

	.skip-link {
		position: fixed;
		top: 12px;
		left: 12px;
		z-index: 10;
		padding: 8px 12px;
		background: var(--color-paper);
		border: 1px solid var(--color-text);
		transform: translateY(calc(-100% - 16px));
	}

	.skip-link:focus {
		transform: translateY(0);
	}
</style>
