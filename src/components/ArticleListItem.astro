---
/**
 * 記事一覧の 1 行。公開日 + タイトル + 抜粋 (2 行) + タグ + 読了目安。
 * 行全体がリンク。ホバーで背景が左から満ち、タイトルに下線が引かれ、矢印が少し進む。
 * タイトルには記事ページの見出しと同じ view-transition-name を付ける。
 */
import { formatFullDate, formatIsoDate } from '../utils/date';
import Tag from './Tag.astro';

interface Props {
	title: string;
	excerpt: string;
	tags: string[];
	href: string;
	date: Date | string;
	readingMinutes?: number;
	/** タイトルに付ける view-transition-name */
	transitionName?: string;
}

const { title, excerpt, tags, href, date, readingMinutes, transitionName } = Astro.props;
const publishedAt = new Date(date);
---

<a class="row" href={href}>
	<time class="date mono" datetime={formatIsoDate(publishedAt)}>{formatFullDate(publishedAt)}</time>
	<div class="main">
		<h3
			class="title-text"
			style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
		>
			<span class="underline">{title}</span>
		</h3>
		<p class="excerpt">{excerpt}</p>
		<div class="tags">
			{tags.map((tag, i) => <Tag variant={i === 0 ? 'accent' : 'outline'}>{tag}</Tag>)}
		</div>
	</div>
	{readingMinutes && <span class="minutes mono">約{readingMinutes}分</span>}
	<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path d="M5 12h13M13 6.5 18.5 12 13 17.5"></path>
	</svg>
</a>

<style>
	.row:any-link {
		position: relative;
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr) auto 24px;
		gap: 12px 32px;
		align-items: start;
		padding: 28px 20px;
		border-bottom: 1px solid var(--color-line);
		color: var(--color-ink);
		text-decoration: none;
		isolation: isolate;
	}

	.row::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--color-surface);
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.row:focus-visible {
		outline-offset: -3px;
	}

	.date {
		padding-top: 4px;
		color: var(--color-muted);
		font-size: 0.8125rem;
		line-height: 1.6;
		font-feature-settings: 'tnum' 1;
	}

	.main {
		display: flex;
		flex-direction: column;
	}

	.title-text {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.55;
	}

	.underline {
		background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
		transition: background-size var(--dur-base) var(--ease-out);
	}

	.excerpt {
		display: -webkit-box;
		margin: 8px 0 0;
		overflow: hidden;
		color: var(--color-ink-2);
		font-size: 0.9375rem;
		line-height: 1.85;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 14px;
	}

	.minutes {
		padding-top: 5px;
		color: var(--color-muted);
		font-size: 0.78125rem;
		white-space: nowrap;
	}

	.arrow {
		width: 20px;
		height: 20px;
		margin-top: 6px;
		fill: none;
		stroke: var(--color-leaf-2);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform var(--dur-base) var(--ease-out);
	}

	@media (hover: hover) {
		.row:hover::before {
			transform: scaleX(1);
		}

		.row:hover .underline {
			background-size: 100% 2px;
		}

		.row:hover .arrow {
			transform: translateX(4px);
		}
	}

	@media (max-width: 720px) {
		.row:any-link {
			grid-template-columns: minmax(0, 1fr) 24px;
			padding: 22px 4px;
		}

		.date {
			grid-column: 1 / -1;
			padding: 0;
		}

		.minutes {
			display: none;
		}
	}
</style>
