---
/**
 * 版ズレ (CMYK) 風の画像フレーム。
 * src 未指定時はプレースホルダーを表示する。
 * キャプションは caption スロットで渡す。
 */
interface Props {
	src?: string;
	alt?: string;
	aspectRatio?: string;
	placeholder?: string;
}

const { src, alt = '', aspectRatio = '3 / 2', placeholder = '写真' } = Astro.props;
const hasCaption = Astro.slots.has('caption');
---

<figure class="cmyk">
	<div class="print" style={`aspect-ratio: ${aspectRatio};`}>
		{
			src ? (
					<img src={src} alt={alt} loading="lazy" decoding="async" />
			) : (
				<div class="placeholder">
					<span>{placeholder}</span>
				</div>
			)
		}
	</div>
	{
		hasCaption && (
			<figcaption>
				<slot name="caption" />
			</figcaption>
		)
	}
</figure>

<style>
	.cmyk {
		margin: 0;
		overflow: visible;
	}

	.print {
		position: relative;
		background: var(--color-neutral-100);
		outline: 1px solid color-mix(in srgb, var(--color-text) 25%, transparent);
		box-shadow:
			4px 4px 0 color-mix(in srgb, var(--color-plate-c) 50%, transparent),
			-4px 4px 0 color-mix(in srgb, var(--color-plate-m) 40%, transparent),
			4px -4px 0 color-mix(in srgb, var(--color-plate-y) 55%, transparent);
	}

	.print img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.placeholder {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		font-size: 13px;
		letter-spacing: 0.08em;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
	}

	figcaption {
		font-size: 12.5px;
		line-height: 24px;
		margin: 14px 0 0;
		color: color-mix(in srgb, var(--color-text) 70%, transparent);
	}
</style>
