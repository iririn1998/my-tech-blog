---
/**
 * 記事ページの目次。DADS の「目次」コンポーネント (枠線あり) に準拠する。
 * デスクトップでは本文の横に sticky 配置する。
 */
interface Props {
	headings: { slug: string; text: string }[];
}

const { headings } = Astro.props;
---

<nav class="dads-toc toc" data-border="solid" aria-labelledby="toc-heading">
	<h2 id="toc-heading" class="dads-toc__heading">目次</h2>
	<ul class="dads-list" data-spacing="4">
		{
			headings.map((heading) => (
				<li>
					<a class="dads-link" href={`#${heading.slug}`}>
						{heading.text}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.toc {
		position: sticky;
		top: calc(24 / 16 * 1rem);
		width: auto;
		border-radius: var(--border-radius-8);
		background: var(--color-bg);
	}

	@media (max-width: 960px) {
		.toc {
			position: static;
		}
	}

	.dads-toc__heading {
		font-weight: var(--font-weight-700);
	}
</style>
