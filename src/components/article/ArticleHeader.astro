---
/**
 * 記事ページのヘッダー。タグ列 + タイトル + 抜粋 + 公開日・読了目安。
 *
 * タイトルには一覧と同じ view-transition-name を付け、一覧から開いたときはカードのタイトルが
 * この見出しへ変形する。タイトル自体には出現アニメーションを付けない（遷移の動きと重なるため）。
 */
import { formatFullDate, formatIsoDate } from '../../utils/date';
import { getTagId } from '../../utils/tag';
import Tag from '../Tag.astro';

interface Props {
	title: string;
	date: Date | string;
	tags: string[];
	excerpt?: string;
	readingMinutes?: number;
	/** 目次に載る見出しの数 */
	sectionCount?: number;
	/** タイトルに付ける view-transition-name */
	transitionName?: string;
}

const { title, date, tags, excerpt, readingMinutes, sectionCount, transitionName } = Astro.props;
const publishedAt = new Date(date);
---

<header class="article-header">
	<ul class="tags" aria-label="タグ">
		{
			tags.map((tag, i) => (
				<li>
					<Tag variant={i === 0 ? 'accent' : 'outline'} href={`/tags/#${getTagId(tag)}`}>
						{tag}
					</Tag>
				</li>
			))
		}
	</ul>
	<h1
		class="title"
		data-article-title
		style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
	>
		{title}
	</h1>
	{excerpt && <p class="lead">{excerpt}</p>}
	<p class="meta mono">
		<span>公開日 <time datetime={formatIsoDate(publishedAt)}>{formatFullDate(publishedAt)}</time></span>
		{readingMinutes && <span>読了目安 約{readingMinutes}分</span>}
		{sectionCount ? <span>セクション {sectionCount}</span> : null}
	</p>
</header>

<style>
	.article-header {
		padding: 40px 0 44px;
		border-bottom: 1px solid var(--color-line);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
		animation: fade-up var(--dur-slow) var(--ease-out) both;
	}

	.title {
		max-width: 22em;
		margin: 20px 0 0;
		color: var(--color-ink);
		font-size: clamp(1.875rem, 4vw, 2.875rem);
		font-weight: 700;
		line-height: 1.38;
		letter-spacing: -0.005em;
	}

	.lead {
		max-width: 42em;
		margin: 20px 0 0;
		color: var(--color-ink-2);
		font-size: 1.0625rem;
		line-height: 1.95;
		animation: fade-up var(--dur-slow) var(--ease-out) 80ms both;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin: 24px 0 0;
		color: var(--color-muted);
		font-size: 0.8125rem;
		line-height: 1.6;
		font-feature-settings: 'tnum' 1;
		animation: fade-up var(--dur-slow) var(--ease-out) 140ms both;
	}

	.meta time {
		color: var(--color-ink-2);
	}
</style>
