---
/**
 * 記事ページのヘッダー。タグ列 + タイトル + 公開日。先頭タグをキーカラーで表示する。
 */
interface Props {
	title: string;
	date: Date | string;
	tags: string[];
}

import { formatFullDate, formatIsoDate } from '../../utils/date';
import Tag from '../Tag.astro';

const { title, date, tags } = Astro.props;
const publishedAt = new Date(date);
const dateLabel = formatFullDate(publishedAt);
const datetime = formatIsoDate(publishedAt);
---

<header class="article-header">
	<h1 class="title">{title}</h1>
	<div class="meta">
		<ul class="tags" aria-label="タグ">
			{
				tags.map((tag, i) => (
					<li>
						<Tag variant={i === 0 ? 'accent' : 'outline'}>{tag}</Tag>
					</li>
				))
			}
		</ul>
		<p class="date">公開日：<time {datetime}>{dateLabel}</time></p>
	</div>
</header>

<style>
	.article-header {
		padding: calc(32 / 16 * 1rem) 0 calc(32 / 16 * 1rem);
		border-bottom: 1px solid var(--color-border);
	}

	/* DADS タイポグラフィ: Std-28B-150 → 広い画面では Std-36B-140 */
	.title {
		max-width: 28em;
		margin: 0;
		color: var(--color-text-strong);
		font-size: var(--font-size-28);
		font-weight: var(--font-weight-700);
		line-height: var(--line-height-150);
		letter-spacing: 0.01em;
	}

	@media (min-width: 768px) {
		.title {
			font-size: var(--font-size-36);
			line-height: var(--line-height-140);
		}
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: calc(12 / 16 * 1rem) calc(24 / 16 * 1rem);
		margin-top: calc(24 / 16 * 1rem);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: calc(8 / 16 * 1rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.date {
		margin: 0;
		color: var(--color-text-description);
		font-size: var(--font-size-16);
		line-height: var(--line-height-170);
		font-feature-settings: 'tnum' 1;
	}
</style>
