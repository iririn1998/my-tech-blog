---
/**
 * 記事ページのヘッダー。タグ列 + タイトル + 日付。先頭タグをアクセント表示。
 */
interface Props {
	title: string;
	date: Date | string;
	tags: string[];
}

import { formatFullDate, formatIsoDate } from '../../utils/date';
import Tag from '../Tag.astro';

const { title, date, tags } = Astro.props;
const publishedAt = new Date(date);
const dateLabel = formatFullDate(publishedAt);
const datetime = formatIsoDate(publishedAt);
---

<header class="article-header">
	<div class="tags">
		{tags.map((tag, i) => <Tag variant={i === 0 ? 'accent' : 'outline'}>{tag}</Tag>)}
	</div>
	<h1>{title}</h1>
	<p class="date"><time {datetime}>{dateLabel}</time></p>
</header>

<style>
	.article-header {
		padding: 56px 0 28px;
		max-width: 46em;
	}

	.tags {
		display: flex;
		gap: var(--space-2);
		margin: 0 0 18px;
	}

	h1 {
		font-size: clamp(30px, 4vw, 46px);
		line-height: 1.3;
		letter-spacing: -0.015em;
		margin: 0;
	}

	.date {
		font-size: 13px;
		line-height: 14px;
		letter-spacing: 0.06em;
		margin: 24px 0 0;
		color: color-mix(in srgb, var(--color-text) 70%, transparent);
		font-feature-settings: 'tnum' 1;
	}
</style>
