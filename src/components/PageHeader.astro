---
/**
 * 一覧・固定ページの見出し。ページタイトル (h1) + 任意のリード文 (default スロット)。
 * 表示時に一度だけ下からフェードインする。
 */
interface Props {
	title: string;
}

const { title } = Astro.props;
const hasLead = Astro.slots.has('default');
---

<header class="page-header">
	<h1 class="title">{title}</h1>
	{
		hasLead && (
			<div class="lead">
				<slot />
			</div>
		)
	}
</header>

<style>
	.page-header {
		padding: 40px 0 48px;
	}

	.title {
		margin: 0;
		color: var(--color-ink);
		font-size: clamp(1.875rem, 4vw, 2.75rem);
		font-weight: 700;
		line-height: 1.38;
		letter-spacing: -0.005em;
		animation: fade-up var(--dur-slow) var(--ease-out) both;
	}

	.lead {
		max-width: 42em;
		margin-top: 20px;
		color: var(--color-ink-2);
		font-size: 1.0625rem;
		line-height: 1.95;
		animation: fade-up var(--dur-slow) var(--ease-out) 80ms both;
	}

	.lead :global(p) {
		margin: 0;
	}

	.lead :global(p + p) {
		margin-top: 16px;
	}
</style>
