---
/**
 * タグ。3 バリアント + 任意でリンク化・件数表示する。
 * - accent: リーフ色の淡い塗り (記事の主タグ)
 * - outline: グレーの枠線 (その他のタグ)
 * - neutral: グレーの塗り (「特集」などの補足ラベル)
 * リンク化した場合は、ホバーで淡い緑が左から満ち、枠線の色も変わる（色の違いだけに頼らない）。
 */
interface Props {
	variant?: 'accent' | 'outline' | 'neutral';
	href?: string;
	/** タグ名の後ろに件数を表示する */
	count?: number;
}

const { variant = 'outline', href, count } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element class:list={['tag', variant, { 'is-link': href }]} href={href}>
	<span class="label"><slot /></span>
	{
		count !== undefined && (
			<span class="count mono">
				{count}
				<span class="visually-hidden">件</span>
			</span>
		)
	}
</Element>

<style>
	.tag {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 26px;
		padding: 1px 11px;
		overflow: hidden;
		border: 1px solid transparent;
		border-radius: 999px;
		font-size: 0.78125rem;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.02em;
		white-space: nowrap;
		text-decoration: none;
		isolation: isolate;
	}

	.accent {
		background: var(--color-leaf-soft);
		color: var(--color-leaf-2);
	}

	.outline {
		border-color: var(--color-line-2);
		color: var(--color-ink-2);
	}

	.neutral {
		background: var(--color-surface-2);
		color: var(--color-ink-2);
	}

	.is-link:any-link {
		min-height: 36px;
		padding: 0 14px;
		font-size: 0.84375rem;
		transition:
			color var(--dur-fast) var(--ease-standard),
			border-color var(--dur-fast) var(--ease-standard);
	}

	.accent.is-link:any-link {
		color: var(--color-leaf-2);
	}

	.outline.is-link:any-link,
	.neutral.is-link:any-link {
		color: var(--color-ink-2);
	}

	.is-link::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--color-leaf-soft);
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--dur-fast) var(--ease-standard);
	}

	.accent.is-link::before {
		background: color-mix(in srgb, var(--color-leaf) 20%, transparent);
	}

	@media (hover: hover) {
		.is-link:hover {
			border-color: var(--color-leaf);
		}

		.outline.is-link:hover,
		.neutral.is-link:hover {
			color: var(--color-leaf-2);
		}

		.is-link:hover::before {
			transform: scaleX(1);
		}
	}

	.is-link:focus-visible {
		border-radius: 999px;
	}

	.count {
		color: var(--color-muted);
		font-size: 0.6875rem;
		font-weight: 500;
		font-feature-settings: 'tnum' 1;
	}
</style>
