---
/**
 * 記事一覧グリッドのカード。タグ + タイトル + 抜粋 (3行クランプ)。
 */
interface Props {
	title: string;
	excerpt: string;
	tag: string;
	href: string;
}

import Tag from './Tag.astro';

const { title, excerpt, tag, href } = Astro.props;
---

<article class="card">
	<Tag>{tag}</Tag>
	<h3><a href={href}>{title}</a></h3>
	<p>{excerpt}</p>
</article>

<style>
	h3 {
		font-size: 20px;
		line-height: 1.45;
		margin: 14px 0 0;
		min-height: 58px;
	}

	h3 a {
		color: inherit;
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--color-accent-700);
	}

	p {
		font-size: 14.5px;
		line-height: 26px;
		margin: 12px 0 0;
		color: color-mix(in srgb, var(--color-text) 78%, transparent);
		text-align: justify;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
