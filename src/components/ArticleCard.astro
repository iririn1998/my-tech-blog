---
/**
 * 記事一覧のカード。DADS のカード作例 (カード全体がリンク) に準拠する。
 * タグ + 公開日 + タイトル + 抜粋 (3行クランプ)。
 */
interface Props {
	title: string;
	excerpt: string;
	tag: string;
	href: string;
	date?: Date | string;
}

import { formatFullDate, formatIsoDate } from '../utils/date';
import Tag from './Tag.astro';

const { title, excerpt, tag, href, date } = Astro.props;
const publishedAt = date ? new Date(date) : undefined;
---

<a class="card" href={href}>
	<span class="meta">
		<Tag>{tag}</Tag>
		{
			publishedAt && (
				<time class="date" datetime={formatIsoDate(publishedAt)}>
					{formatFullDate(publishedAt)}
				</time>
			)
		}
	</span>
	<h3 class="title">{title}</h3>
	<p class="excerpt">{excerpt}</p>
</a>

<style>
	.card:any-link {
		display: flex;
		flex-direction: column;
		gap: calc(16 / 16 * 1rem);
		height: 100%;
		border: 1px solid var(--color-border);
		border-radius: var(--border-radius-16);
		background: var(--color-bg);
		padding: calc(24 / 16 * 1rem);
		color: var(--color-text-body);
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.card:focus-visible {
		border-radius: var(--border-radius-16);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: calc(8 / 16 * 1rem) calc(16 / 16 * 1rem);
	}

	.date {
		color: var(--color-text-description);
		font-size: var(--font-size-14);
		line-height: var(--line-height-130);
		letter-spacing: 0;
		font-feature-settings: 'tnum' 1;
	}

	.title {
		margin: 0;
		color: var(--color-text-strong);
		font-size: var(--font-size-20);
		font-weight: var(--font-weight-700);
		line-height: var(--line-height-150);
		letter-spacing: 0.02em;
		text-decoration: underline;
		text-decoration-thickness: calc(1 / 16 * 1rem);
		text-underline-offset: calc(3 / 16 * 1rem);
	}

	@media (hover: hover) {
		.card:hover .title {
			text-decoration-thickness: calc(3 / 16 * 1rem);
		}
	}

	.excerpt {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		font-size: var(--font-size-16);
		line-height: var(--line-height-170);
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}
</style>
