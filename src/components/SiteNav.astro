---
/**
 * サイト共通ナビゲーション。現在ページのリンクをアクセント色で表示する。
 */
const links = [
	{ label: 'トップ', href: '/' },
	{ label: 'タグ', href: '/tags/' },
	{ label: 'About', href: '/about/' },
];

const currentPath = Astro.url?.pathname ?? '/';

function isActive(href: string): boolean {
	const normalizedHref = href === '/' ? href : href.replace(/\/$/, '');
	return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}
---

<nav aria-label="主要ナビゲーション" class="nav">
	<span class="nav-brand"><a href="/">Web技報</a></span>
	{
		links.map((link) => (
			<a
				class:list={['nav-link', { active: isActive(link.href) }]}
				href={link.href}
				aria-current={isActive(link.href) ? 'page' : undefined}
			>
				{link.label}
			</a>
		))
	}
</nav>

<style>
	.nav {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 16px 24px;
		max-width: 1200px;
		margin: 0 auto;
		padding: 20px clamp(20px, 5vw, 72px);
		border-bottom: 3px double color-mix(in srgb, var(--color-text) 60%, transparent);
	}

	.nav-brand {
		font-family: var(--font-heading);
		font-size: 21px;
		font-weight: 700;
		letter-spacing: -0.01em;
		margin-right: 12px;
	}

	.nav-brand a {
		color: inherit;
		text-decoration: none;
	}

	.nav-link {
		font-size: 14.5px;
		text-decoration: none;
		color: var(--color-text);
		white-space: nowrap;
	}

	.nav-link:hover,
	.nav-link.active {
		color: var(--color-accent-700);
	}

</style>
