---
/**
 * 「最新の記事」「目次」などのセクション見出しラベル。
 * 余白は呼び出し側で制御する。
 */
interface Props {
	as?: 'span' | 'p' | 'h2';
	id?: string;
}

const { as: Element = 'span', id }: Props = Astro.props;
---

<Element {id} class="section-label"><slot /></Element>

<style>
	.section-label {
		display: block;
		font-size: 12.5px;
		font-weight: 400;
		line-height: 14px;
		letter-spacing: 0.08em;
		margin: 0;
		color: color-mix(in srgb, var(--color-text) 70%, transparent);
	}
</style>
