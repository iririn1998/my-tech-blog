---
/**
 * サイト共通フッター。
 */
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
const links = [
	{ label: 'トップ', href: '/' },
	{ label: 'タグ', href: '/tags/' },
	{ label: 'About', href: '/about/' },
];
---

<footer class="site-footer">
	<div class="inner">
		<div class="about">
			<p class="name">
				<span>いりりんご</span>
				<BrandMark size={20} />
				<span>web牧場</span>
			</p>
			<p class="note">個人の技術記録です。記載内容は執筆時点のものです。</p>
		</div>
		<nav aria-label="フッターナビゲーション">
			<ul class="links">
				{
					links.map((link) => (
						<li>
							<a class="link-wipe" href={link.href}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<p class="copyright mono">
			<small>© {year} いりりんご web牧場 · Built with Astro · Deployed on Cloudflare Workers</small>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 96px;
		border-top: 1px solid var(--color-line);
		background: var(--color-surface);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 24px 48px;
		max-width: var(--layout-max-width);
		margin: 0 auto;
		padding: 48px var(--layout-gutter) 56px;
	}

	p {
		margin: 0;
	}

	.name {
		display: flex;
		align-items: center;
		gap: 3px;
		color: var(--color-ink);
		font-size: 1.0625rem;
		font-weight: 700;
		line-height: 1.6;
	}

	.note {
		margin-top: 8px;
		color: var(--color-ink-2);
		font-size: 0.875rem;
		line-height: 1.8;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin: 0;
		padding: 0;
		font-size: 0.875rem;
		list-style: none;
	}

	.copyright {
		flex-basis: 100%;
		color: var(--color-muted);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.copyright small {
		font-size: inherit;
	}
</style>
