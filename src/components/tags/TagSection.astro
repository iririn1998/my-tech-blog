---
/**
 * タグ別一覧ページの1タグ分の節。タグ見出し + 記事リスト (タイトル + 公開日)。
 */
interface Props {
	name: string;
	posts: { title: string; href: string; dateLabel: string; datetime: string }[];
}

import { getTagId } from '../../utils/tag';

const { name, posts } = Astro.props;
const id = getTagId(name);
---

<section {id} class="tag-section" aria-labelledby={`${id}-heading`}>
	<h2 id={`${id}-heading`} class="dads-heading heading" data-size="20" data-chip>
		{name}<span class="count">{posts.length}記事</span>
	</h2>
	<ul class="list">
		{
			posts.map((post) => (
				<li>
					<a href={post.href}>{post.title}</a>
					<time class="date" datetime={post.datetime}>
						{post.dateLabel}
					</time>
				</li>
			))
		}
	</ul>
</section>

<style>
	.tag-section {
		border: 1px solid var(--color-border);
		border-radius: var(--border-radius-16);
		padding: calc(24 / 16 * 1rem);
	}

	.heading {
		margin: 0;
	}

	.count {
		margin-left: calc(12 / 16 * 1rem);
		color: var(--color-text-description);
		font-size: var(--font-size-14);
		font-weight: var(--font-weight-400);
		letter-spacing: 0;
	}

	.list {
		margin: calc(16 / 16 * 1rem) 0 0;
		padding: 0;
		list-style: none;
	}

	.list li {
		display: flex;
		flex-direction: column;
		gap: calc(4 / 16 * 1rem);
		padding: calc(12 / 16 * 1rem) 0;
	}

	.list li + li {
		border-top: 1px solid var(--color-border-subtle);
	}

	.list li:last-child {
		padding-bottom: 0;
	}

	.date {
		color: var(--color-text-description);
		font-size: var(--font-size-14);
		line-height: var(--line-height-130);
		letter-spacing: 0;
		font-feature-settings: 'tnum' 1;
	}
</style>
