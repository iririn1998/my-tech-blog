---
/**
 * タグ別一覧ページ上部のタグ一覧。各タグはページ内の節へのリンク。
 */
interface Props {
	tags: { name: string; count: number }[];
}

import Tag from '../Tag.astro';
import { getTagId } from '../../utils/tag';

const { tags } = Astro.props;
---

<ul class="cloud">
	{
		tags.map((tag) => (
			<li>
				<Tag href={`#${getTagId(tag.name)}`} count={tag.count}>
					{tag.name}
				</Tag>
			</li>
		))
	}
</ul>

<style>
	.cloud {
		display: flex;
		flex-wrap: wrap;
		gap: calc(8 / 16 * 1rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
