---
/**
 * タグの一覧。各タグはリンクで、件数を添える。
 * 既定ではページ内の節 (#tag-xxx) へリンクする。別ページへ飛ばす場合は hrefFor を渡す。
 */
import { getTagId } from '../../utils/tag';
import Tag from '../Tag.astro';

interface Props {
	tags: { name: string; count: number }[];
	/** タグ名からリンク先を作る関数（既定はページ内リンク） */
	hrefFor?: (name: string) => string;
}

const { tags, hrefFor = (name: string) => `#${getTagId(name)}` } = Astro.props;
---

<ul class="cloud">
	{
		tags.map((tag) => (
			<li>
				<Tag href={hrefFor(tag.name)} count={tag.count}>
					{tag.name}
				</Tag>
			</li>
		))
	}
</ul>

<style>
	.cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
