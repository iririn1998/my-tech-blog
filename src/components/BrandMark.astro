---
/**
 * サイトのロゴマーク（りんご）。サイト名の絵文字 🍎 の代わりに使う装飾用 SVG。
 * 親要素に .brand があれば、ホバー時に葉が一度だけ揺れる。
 */
interface Props {
	size?: number;
}

const { size = 22 } = Astro.props;
---

<svg
	class="brand-mark"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	aria-hidden="true"
	focusable="false"
>
	<path
		class="body"
		d="M12 7.6c-1.6-1.2-4.7-1.4-6.3.6-1.9 2.4-1.2 6.7.9 9.5 1.2 1.6 2.6 2.9 4 2.3.6-.3.9-.4 1.4-.4s.8.1 1.4.4c1.4.6 2.8-.7 4-2.3 2.1-2.8 2.8-7.1.9-9.5-1.6-2-4.7-1.8-6.3-.6z"
	></path>
	<path class="stem" d="M12 7.6c0-1.5.4-2.9 1.4-4"></path>
	<path class="leaf" d="M13.3 5.3c.3-1.9 1.8-3 3.9-2.9-.3 1.9-1.8 3.1-3.9 2.9z"></path>
</svg>

<style>
	.brand-mark {
		flex: none;
	}

	.body {
		fill: var(--color-apple);
	}

	.stem {
		fill: none;
		stroke: var(--color-ink);
		stroke-width: 1.6;
		stroke-linecap: round;
	}

	.leaf {
		fill: var(--color-leaf);
		transform-box: view-box;
		transform-origin: 13.3px 5.3px;
	}

	@media (hover: hover) {
		:global(.brand:hover) .leaf {
			animation: sway 900ms var(--ease-out);
		}
	}

	@keyframes sway {
		30% {
			transform: rotate(-16deg);
		}

		65% {
			transform: rotate(7deg);
		}
	}
</style>
