---
/**
 * トップページの特集記事。テキスト + 画像の横長カード (狭い画面では画像が上)。
 * 見出しは呼び出し側のセクション見出しの下に置く想定で h3 を使う。
 */
interface Props {
	title: string;
	excerpt: string;
	tag: string;
	href: string;
	date?: Date | string;
	imageSrc?: string;
}

import { formatFullDate, formatIsoDate } from '../../utils/date';
import Tag from '../Tag.astro';

const { title, excerpt, tag, href, date, imageSrc } = Astro.props;
const publishedAt = date ? new Date(date) : undefined;
---

<article class="featured">
	<div class="body">
		<div class="meta">
			<Tag variant="accent">{tag}</Tag>
			{
				publishedAt && (
					<time class="date" datetime={formatIsoDate(publishedAt)}>
						{formatFullDate(publishedAt)}
					</time>
				)
			}
		</div>
		<h3 class="title"><a href={href}>{title}</a></h3>
		<p class="excerpt">{excerpt}</p>
		<p class="more">
			<a class="dads-button" data-size="md" data-type="solid-fill" href={href}>
				続きを読む<span class="dads-u-visually-hidden">：{title}</span>
			</a>
		</p>
	</div>
	<div class="media">
		{
			imageSrc ? (
				<img src={imageSrc} alt="" loading="lazy" decoding="async" />
			) : (
				<span class="placeholder">画像なし</span>
			)
		}
	</div>
</article>

<style>
	.featured {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas:
			'media'
			'body';
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--border-radius-16);
		background: var(--color-bg);
	}

	@media (min-width: 800px) {
		.featured {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			grid-template-areas: 'body media';
		}
	}

	.body {
		grid-area: body;
		padding: calc(24 / 16 * 1rem);
	}

	@media (min-width: 800px) {
		.body {
			align-self: center;
			padding: calc(40 / 16 * 1rem);
		}
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: calc(8 / 16 * 1rem) calc(16 / 16 * 1rem);
	}

	.date {
		color: var(--color-text-description);
		font-size: var(--font-size-14);
		line-height: var(--line-height-130);
		letter-spacing: 0;
		font-feature-settings: 'tnum' 1;
	}

	/* DADS タイポグラフィ: Std-24B-150 → 広い画面では Std-28B-150 */
	.title {
		margin: calc(16 / 16 * 1rem) 0 0;
		font-size: var(--font-size-24);
		font-weight: var(--font-weight-700);
		line-height: var(--line-height-150);
		letter-spacing: 0.02em;
	}

	@media (min-width: 800px) {
		.title {
			font-size: var(--font-size-28);
			letter-spacing: 0.01em;
		}
	}

	.title a:any-link {
		color: var(--color-text-strong);
	}

	.excerpt {
		margin: calc(16 / 16 * 1rem) 0 0;
		font-size: var(--font-size-16);
		line-height: var(--line-height-170);
	}

	.more {
		margin: calc(24 / 16 * 1rem) 0 0;
	}

	.media {
		grid-area: media;
		display: grid;
		place-items: center;
		aspect-ratio: 3 / 2;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg-subtle);
	}

	@media (min-width: 800px) {
		.media {
			aspect-ratio: auto;
			min-height: 100%;
			border-bottom: 0;
			border-left: 1px solid var(--color-border);
		}
	}

	.media img {
		display: block;
		width: 100%;
		height: 100%;
		max-height: calc(320 / 16 * 1rem);
		object-fit: contain;
	}

	.placeholder {
		color: var(--color-text-description);
		font-size: var(--font-size-14);
	}
</style>
