---
import { getCollection } from 'astro:content';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHeader from '../../components/PageHeader.astro';
import TagCloud from '../../components/tags/TagCloud.astro';
import TagSection from '../../components/tags/TagSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatFullDate, formatIsoDate } from '../../utils/date';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 記事の新しい順にタグを収集 (最新記事のタグが先頭になる)
const tagMap = new Map<string, typeof posts>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		const entries = tagMap.get(tag) ?? [];
		entries.push(post);
		tagMap.set(tag, entries);
	}
}

const tags = [...tagMap.entries()].map(([name, entries]) => ({
	name,
	count: entries.length,
	posts: entries.map((post) => ({
		title: post.data.title,
		href: `/posts/${post.id}/`,
		dateLabel: formatFullDate(post.data.pubDate),
		datetime: formatIsoDate(post.data.pubDate),
	})),
}));
---

<BaseLayout title="タグ別一覧 | いりりんご🍎web牧場" description="記事をタグ別に整理しています。">
	<Breadcrumb items={[{ label: 'タグ別一覧' }]} />
	<PageHeader title="タグ別一覧">
		<p>
			全{posts.length}記事を{tags.length}のタグで整理しています。タグを選ぶと該当の節へ移動します。
		</p>
	</PageHeader>
	<nav aria-label="タグ一覧" class="cloud-wrap">
		<TagCloud tags={tags} />
	</nav>
	<div class="grid">
		{tags.map((tag) => <TagSection name={tag.name} posts={tag.posts} />)}
	</div>
</BaseLayout>

<style>
	.cloud-wrap {
		margin: 0 0 48px;
		animation: fade-up var(--dur-slow) var(--ease-out) 160ms both;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr));
		gap: 24px;
		align-items: start;
	}
</style>
