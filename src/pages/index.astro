---
import { getCollection } from 'astro:content';
import ArticleListItem from '../components/ArticleListItem.astro';
import FeaturedArticle from '../components/home/FeaturedArticle.astro';
import HomeHero from '../components/home/HomeHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TagCloud from '../components/tags/TagCloud.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getReadingMinutes, getTitleTransitionName } from '../utils/post';
import { getTagId } from '../utils/tag';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post.id !== featured.id);

// 記事数の多い順（同数なら新しい記事のタグが先）
const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts.entries()]
	.map(([name, count]) => ({ name, count }))
	.sort((a, b) => b.count - a.count);
---

<BaseLayout
	title="いりりんご🍎web牧場 — 個人の技術記録"
	description="Webフロントエンドを中心とした、個人の技術記録。試したこと、つまずいたこと、直したことを毎週書き留めています。"
>
	<HomeHero tags={tags.slice(0, 4)} />

	<section aria-labelledby="featured-heading" class="section">
		<SectionHeading index="01" id="featured-heading" title="特集記事" />
		<FeaturedArticle
			title={featured.data.title}
			excerpt={featured.data.excerpt}
			tags={featured.data.tags}
			href={`/posts/${featured.id}/`}
			date={featured.data.pubDate}
			fileName={`posts/${featured.id}.md`}
			readingMinutes={getReadingMinutes(featured.body)}
			transitionName={getTitleTransitionName(featured.id)}
		/>
	</section>

	{
		latest.length > 0 && (
			<section aria-labelledby="latest-heading" class="section">
				<SectionHeading index="02" id="latest-heading" title="最新の記事">
					<a class="link-wipe" href="/tags/">
						タグから探す
					</a>
				</SectionHeading>
				<ul class="list">
					{latest.map((post) => (
						<li class="reveal">
							<ArticleListItem
								title={post.data.title}
								excerpt={post.data.excerpt}
								tags={post.data.tags}
								href={`/posts/${post.id}/`}
								date={post.data.pubDate}
								readingMinutes={getReadingMinutes(post.body)}
								transitionName={getTitleTransitionName(post.id)}
							/>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section aria-labelledby="tags-heading" class="section">
		<SectionHeading index={latest.length > 0 ? '03' : '02'} id="tags-heading" title="タグから探す" />
		<div class="reveal">
			<TagCloud tags={tags} hrefFor={(name) => `/tags/#${getTagId(name)}`} />
		</div>
	</section>
</BaseLayout>

<style>
	.section {
		padding: 16px 0 64px;
	}

	.list {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-line);
		list-style: none;
	}
</style>
